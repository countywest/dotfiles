#!/bin/bash
# pid.fzf [query]: pick processes with fzf (busiest first) and print their PIDs, one per line.
#   kill $(pid.fzf)             # TAB selects several
#   kill -9 $(pid.fzf python)   # start with a query
set -eu -o pipefail

ps -e -o pid,user,pcpu,pmem,etime,args |
  { IFS= read -r header; printf '%s\n' "$header"; sort -k3,3nr; } |
  fzf --multi --reverse --header-lines=1 --query="$*" \
      --preview='ps -o args= -p {1}' --preview-window=down:3:wrap |
  awk '{print $1}'
